# Copia este archivo como ".env" y rellena tus valores reales.
# NUNCA subas el archivo ".env" real a GitHub (ya está en .gitignore).

# Token de la API del Banco Central de Chile (autenticación REST).
# Se solicita gratis en: https://si3.bcentral.cl/Siete/en/Siete/API
BCCH_TOKEN=tu_token_aqui

# Conexión a PostgreSQL.
# En Railway esta variable se genera sola al conectar una base de datos.
# Para desarrollo local, instala PostgreSQL o usa un servicio gratuito
# como Neon/Supabase y pega la URL aquí.
DATABASE_URL=postgresql://usuario:password@localhost:5432/mercado_chile

# API key de Gemini (Google AI Studio), para generar el resumen diario del
# Brief Premercado. Se solicita gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_aqui
